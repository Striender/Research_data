#include "cache.h"
#include <unordered_set>
#include <unordered_map>

#define maxRRPV 3
uint32_t l1d_rrpv[L1D_SET][L1D_WAY];
unordered_set<uint64_t> l1d_demand_resident;
unordered_map<uint64_t, uint64_t> l1d_evicted_by_prefetch;
uint64_t l1d_pollution_count = 0;
uint64_t miss_l1d = 0;

void reset_l1d_pollution_stats(){
    l1d_demand_resident.clear();
    l1d_evicted_by_prefetch.clear();
    l1d_pollution_count = 0;
}

// initialize replacement state
void CACHE::l1d_initialize_replacement()
{
    cout << "Initialize SRRIP state for l1d" << endl;

    for (int i = 0; i < L1D_SET; i++)
    {
        for (int j = 0; j < L1D_WAY; j++)
        {
            l1d_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l1d_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{

    // look for the maxRRPV line
    while (1)
    {
        for (int i = 0; i < L1D_WAY; i++)
        {
            if (l1d_rrpv[set][i] == maxRRPV)
            {
                if (!(current_set[i].prefetch && type == PREFETCH))
                {
                    l1d_evicted_by_prefetch.insert({current_set[i].full_addr >> LOG2_BLOCK_SIZE, full_addr >> LOG2_BLOCK_SIZE});
                }
                return i;
            }
        }

        for (int i = 0; i < L1D_WAY; i++)
            l1d_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l1d_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    bool is_prefetched = (type == PREFETCH);
    bool is_demand = (type == LOAD);

    if ((type == WRITEBACK) && ip)
        assert(0);

    if(is_demand && !hit){
        miss_l1d ++ ;
    }
    // uncomment this line to see the l1d accesses
    // cout << "CPU: " << cpu << "  l1d " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;
    uint64_t requested_addr = full_addr >> LOG2_BLOCK_SIZE;
    // 1) Handle the victim if this access caused an eviction (on a miss)

    if (!hit && is_demand)
    {
        auto it2 = l1d_evicted_by_prefetch.find(requested_addr);
        if (it2 != l1d_evicted_by_prefetch.end())
        {
            auto it3 = l1d_demand_resident.find(it2->second);

            if (it3 == l1d_demand_resident.end())
            {
                l1d_pollution_count++;
                l1d_evicted_by_prefetch.erase(it2);
            }
        }
        // If the miss results in an installation in l1d (not bypass), mark as resident demand line
        if (way < L1D_WAY)
        {
            l1d_demand_resident.insert(requested_addr);
        }
    }

     if (hit && is_demand && way < L1D_WAY)
    {
        l1d_demand_resident.insert(requested_addr);
    }
    // 3) If this is a demand hit in l1d, the line is definitely useful.
    //    Mark it as demand-resident (if not already).


    if (hit)
        l1d_rrpv[set][way] = 0;
    else
        l1d_rrpv[set][way] = maxRRPV - 1;
}

// use this function to print out your own stats at the end of simulation
void CACHE::l1d_replacement_final_stats()
{
    cout << "================ SRRIP (l1d) Pollution Stats ================" << endl;
    cout << "Total pollution count in l1d: " << l1d_pollution_count << endl;
    cout<< "load misses: " << miss_l1d <<endl ; 
    cout << "==================================================================" << endl;
}