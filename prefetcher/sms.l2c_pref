// Standalone L2 SMS adapter for the Berti ChampSim interface.
// Behavior is based on Dragon/prefetcher/sms.cc (PC + trigger offset).

#include "cache.h"

#include <algorithm>
#include <bitset>
#include <cassert>
#include <cstdint>
#include <deque>
#include <iostream>
#include <string>
#include <vector>
#include <unordered_set>

namespace dragon_sms {

constexpr uint32_t AT_SIZE = 32;
constexpr uint32_t FT_SIZE = 64;
constexpr uint32_t PHT_SIZE = 16*1024;
constexpr uint32_t PHT_ASSOC = 16;
constexpr uint32_t PREF_DEGREE = 4;
constexpr uint32_t REGION_SIZE = 4*1024;
constexpr uint32_t REGION_SIZE_LOG = 13;
constexpr bool ENABLE_PREF_BUFFER = true;
constexpr uint32_t PREF_BUFFER_SIZE = 256;
constexpr uint32_t REGION_LINES = REGION_SIZE >> LOG2_BLOCK_SIZE;

static_assert((REGION_SIZE & (REGION_SIZE - 1)) == 0,
              "SMS region size must be a power of two");
static_assert(REGION_LINES > 0 && REGION_LINES <= 128,
              "SMS supports between 1 and 128 cache lines per region");
static_assert(PHT_ASSOC > 0 && PHT_SIZE % PHT_ASSOC == 0,
              "SMS PHT size must be divisible by its associativity");

using Pattern = std::bitset<128>;

struct FTEntry {
    uint64_t page;
    uint64_t pc;
    uint32_t trigger_offset;
};

struct ATEntry {
    uint64_t page;
    uint64_t pc;
    uint32_t trigger_offset;
    Pattern pattern;
    uint32_t age;
};

struct PHTEntry {
    uint64_t signature;
    Pattern pattern;
    uint32_t age;
};

struct Stats {
    uint64_t ft_lookup = 0;
    uint64_t ft_hit = 0;
    uint64_t ft_insert = 0;
    uint64_t ft_evict = 0;
    uint64_t at_lookup = 0;
    uint64_t at_hit = 0;
    uint64_t at_insert = 0;
    uint64_t at_evict = 0;
    uint64_t pht_lookup = 0;
    uint64_t pht_hit = 0;
    uint64_t pht_insert = 0;
    uint64_t pht_evict = 0;
    uint64_t generate_called = 0;
    uint64_t generate_miss = 0;
    uint64_t generated = 0;
    uint64_t buffered = 0;
    uint64_t spilled = 0;
    uint64_t issued = 0;
};

class SMS {
  public:
    explicit SMS(uint32_t cpu) : cpu(cpu), pht(PHT_SIZE / PHT_ASSOC) {}

    std::vector<uint64_t> access(uint64_t pc, uint64_t address) {
        std::vector<uint64_t> result;
        const uint64_t page = address >> REGION_SIZE_LOG;
        const uint32_t offset = static_cast<uint32_t>(
            (address >> LOG2_BLOCK_SIZE) & (REGION_LINES - 1));

        auto at = find_at(page);
        stats.at_lookup++;
        if (at != accumulation_table.end()) {
            stats.at_hit++;
            at->pattern[offset] = true;
            touch_at(at);
        } else {
            auto ft = find_ft(page);
            stats.ft_lookup++;
            if (ft != filter_table.end()) {
                stats.ft_hit++;
                insert_at(*ft, offset);
                filter_table.erase(ft);
                stats.ft_evict++;
            } else {
                insert_ft(pc, page, offset);
                generate(pc, page, offset, result);
                if (ENABLE_PREF_BUFFER) {
                    buffer(result);
                    result.clear();
                }
            }
        }

        if (ENABLE_PREF_BUFFER)
            issue(result);
        return result;
    }

    void print_config(uint32_t cpu) const {
        std::cout << "CPU " << cpu << " Dragon SMS configuration\n"
                  << "sms_at_size " << AT_SIZE << '\n'
                  << "sms_ft_size " << FT_SIZE << '\n'
                  << "sms_pht_size " << PHT_SIZE << '\n'
                  << "sms_pht_assoc " << PHT_ASSOC << '\n'
                  << "sms_pref_degree " << PREF_DEGREE << '\n'
                  << "sms_region_size " << REGION_SIZE << '\n'
                  << "sms_region_size_log " << REGION_SIZE_LOG << '\n'
                  << "sms_enable_pref_buffer " << ENABLE_PREF_BUFFER << '\n'
                  << "sms_pref_buffer_size " << PREF_BUFFER_SIZE << '\n';
    }

    void print_stats(uint32_t cpu) const {
        std::cout << "CPU " << cpu << " L2C SMS prefetcher final stats" << std::endl
                  << "sms.ft.lookup " << stats.ft_lookup << '\n'
                  << "sms.ft.hit " << stats.ft_hit << '\n'
                  << "sms.ft.insert " << stats.ft_insert << '\n'
                  << "sms.ft.evict " << stats.ft_evict << '\n'
                  << "sms.at.lookup " << stats.at_lookup << '\n'
                  << "sms.at.hit " << stats.at_hit << '\n'
                  << "sms.at.insert " << stats.at_insert << '\n'
                  << "sms.at.evict " << stats.at_evict << '\n'
                  << "sms.pht.lookup " << stats.pht_lookup << '\n'
                  << "sms.pht.hit " << stats.pht_hit << '\n'
                  << "sms.pht.insert " << stats.pht_insert << '\n'
                  << "sms.pht.unique_insert " << unique_pht_signatures.size() << '\n'
                  << "sms.pht.evict " << stats.pht_evict << '\n'
                  << "sms.generate_prefetch.called " << stats.generate_called << '\n'
                  << "sms.generate_prefetch.pht_miss " << stats.generate_miss << '\n'
                  << "sms.generate_prefetch.pref_generated " << stats.generated << '\n'
                  << "sms.pref_buffer.buffered " << stats.buffered << '\n'
                  << "sms.pref_buffer.spilled " << stats.spilled << '\n'
                  << "sms.pref_buffer.issued " << stats.issued << '\n';
    }

  private:
    using FTIterator = std::deque<FTEntry>::iterator;
    using ATIterator = std::deque<ATEntry>::iterator;
    using PHTIterator = std::deque<PHTEntry>::iterator;

    FTIterator find_ft(uint64_t page) {
        return std::find_if(filter_table.begin(), filter_table.end(),
                            [page](const FTEntry& entry) { return entry.page == page; });
    }

    ATIterator find_at(uint64_t page) {
        return std::find_if(accumulation_table.begin(), accumulation_table.end(),
                            [page](const ATEntry& entry) { return entry.page == page; });
    }

    void insert_ft(uint64_t pc, uint64_t page, uint32_t offset) {
        stats.ft_insert++;
        if (filter_table.size() >= FT_SIZE) {
            filter_table.pop_front(); // Dragon SMS uses FIFO replacement for FT.
            stats.ft_evict++;
        }
        filter_table.push_back({page, pc, offset});
    }

    ATIterator oldest_at() {
        return std::max_element(
            accumulation_table.begin(), accumulation_table.end(),
            [](const ATEntry& lhs, const ATEntry& rhs) { return lhs.age < rhs.age; });
    }

    void insert_at(const FTEntry& ft, uint32_t second_offset) {
        stats.at_insert++;
        if (accumulation_table.size() >= AT_SIZE) {
            auto victim = oldest_at();
            insert_pht(*victim);
            accumulation_table.erase(victim);
            stats.at_evict++;
        }

        for (auto& entry : accumulation_table)
            entry.age++;

        ATEntry entry{};
        entry.page = ft.page;
        entry.pc = ft.pc;
        entry.trigger_offset = ft.trigger_offset;
        entry.pattern[ft.trigger_offset] = true;
        entry.pattern[second_offset] = true;
        entry.age = 0;
        accumulation_table.push_back(entry);
    }

    void touch_at(ATIterator current) {
        for (auto& entry : accumulation_table)
            entry.age++;
        current->age = 0;
    }

    uint64_t signature(uint64_t pc, uint32_t offset) const {
        return (pc << 5) + offset;
    }

    PHTIterator find_pht(uint32_t set, uint64_t key) {
        return std::find_if(pht[set].begin(), pht[set].end(),
                            [key](const PHTEntry& entry) { return entry.signature == key; });
    }

    PHTIterator oldest_pht(uint32_t set) {
        return std::max_element(
            pht[set].begin(), pht[set].end(),
            [](const PHTEntry& lhs, const PHTEntry& rhs) { return lhs.age < rhs.age; });
    }

    void touch_pht(uint32_t set, PHTIterator current) {
        for (auto& entry : pht[set])
            entry.age++;
        current->age = 0;
    }

    void insert_pht(const ATEntry& source) {
        stats.pht_lookup++;
        const uint64_t key = signature(source.pc, source.trigger_offset);
        const uint32_t set = static_cast<uint32_t>(key % pht.size());
        auto current = find_pht(set, key);

        if (current != pht[set].end()) {
            stats.pht_hit++;
            current->pattern = source.pattern;
            touch_pht(set, current);
            return;
        }

        if (pht[set].size() >= PHT_ASSOC) {
            auto victim = oldest_pht(set);
            std::cout << "CPU " << cpu
                      << " SMS PHT eviction: set " << set
                      << " region 0x" << std::hex << source.page
                      << " victim_signature 0x" << victim->signature
                      << " incoming_signature 0x" << key
                      << std::dec << std::endl;
            pht[set].erase(victim);
            stats.pht_evict++;
        }

        stats.pht_insert++;
        unique_pht_signatures.insert(key);
        // Preserve Dragon/sms.cc behavior: insertion resets existing PHT ages.
        for (auto& entry : pht[set])
            entry.age = 0;
        pht[set].push_back({key, source.pattern, 0});
    }

    void generate(uint64_t pc, uint64_t page, uint32_t offset,
                  std::vector<uint64_t>& result) {
        stats.generate_called++;
        const uint64_t key = signature(pc, offset);
        const uint32_t set = static_cast<uint32_t>(key % pht.size());
        auto current = find_pht(set, key);
        if (current == pht[set].end()) {
            stats.generate_miss++;
            return;
        }

        for (uint32_t index = 0; index < REGION_LINES; ++index) {
            if (current->pattern[index] && index != offset) {
                result.push_back((page << REGION_SIZE_LOG) +
                                 (static_cast<uint64_t>(index) << LOG2_BLOCK_SIZE));
            }
        }
        touch_pht(set, current);
        stats.generated += result.size();
    }

    void buffer(const std::vector<uint64_t>& addresses) {
        uint64_t accepted = 0;
        for (uint64_t address : addresses) {
            if (prefetch_buffer.size() >= PREF_BUFFER_SIZE)
                break;
            prefetch_buffer.push_back(address);
            accepted++;
        }
        stats.buffered += accepted;
        stats.spilled += addresses.size() - accepted;
    }

    void issue(std::vector<uint64_t>& result) {
        uint32_t count = 0;
        while (!prefetch_buffer.empty() && count < PREF_DEGREE) {
            result.push_back(prefetch_buffer.front());
            prefetch_buffer.pop_front();
            count++;
        }
        stats.issued += count;
    }

    std::deque<FTEntry> filter_table;
    std::deque<ATEntry> accumulation_table;
    uint32_t cpu;
    std::vector<std::deque<PHTEntry>> pht;
    std::unordered_set<uint64_t> unique_pht_signatures;
    std::deque<uint64_t> prefetch_buffer;
    Stats stats;
};

} // namespace dragon_sms

static std::vector<dragon_sms::SMS*> sms_prefetchers;

void CACHE::l2c_prefetcher_initialize()
{
    if (sms_prefetchers.empty()) {
        sms_prefetchers.resize(NUM_CPUS, nullptr);
        for (uint32_t i = 0; i < NUM_CPUS; ++i)
            sms_prefetchers[i] = new dragon_sms::SMS(i);
    }
    sms_prefetchers[cpu]->print_config(cpu);
}

uint32_t CACHE::l2c_prefetcher_operate(uint64_t addr, uint64_t ip,
                                       uint8_t cache_hit, uint8_t type,
                                       uint32_t metadata_in,
                                       uint8_t critical_ip_flag)
{
    (void)cache_hit;
    (void)type;
    (void)critical_ip_flag;

    const std::vector<uint64_t> addresses = sms_prefetchers[cpu]->access(ip, addr);
    for (uint64_t pf_address : addresses)
        prefetch_line(ip, addr, pf_address, FILL_L2, 0);
    return metadata_in;
}

uint32_t CACHE::l2c_prefetcher_cache_fill(uint64_t addr, uint32_t set,
                                          uint32_t way, uint8_t prefetch,
                                          uint64_t evicted_addr,
                                          uint32_t metadata_in)
{
    // Dragon's sms.cc does not terminate generations on cache eviction.
    (void)addr;
    (void)set;
    (void)way;
    (void)prefetch;
    (void)evicted_addr;
    return metadata_in;
}

void CACHE::l2c_prefetcher_final_stats()
{
    sms_prefetchers[cpu]->print_stats(cpu);
}
